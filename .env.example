# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Voice chat TURN relay (needed for Wi-Fi <-> mobile data / CGNAT). Render does NOT provide TURN.
# Pick ONE option. Credentials stay on the backend; the frontend fetches them from /api/ice-servers.
# A) Metered.ca managed TURN:
# METERED_DOMAIN="yourapp.metered.live"
# METERED_API_KEY="..."
# B) Your own coturn (use-auth-secret) -> temporary credentials are generated per request:
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp"
# TURN_SECRET="..."
# C) Fixed TURN account:
# TURN_URLS="turn:..."  TURN_USERNAME="..."  TURN_CREDENTIAL="..."
# Test the relay: open the game with ?relay=1 in the URL (forces TURN-only).

# --- Image search (all free). Wikipedia (Arabic + English), Wikimedia Commons and Openverse work with NO key.
# Optional but recommended, both free:
# Pexels: sign up at https://www.pexels.com/api/ -> key shown instantly (200 requests/hour). Needs a visible
# "Pexels" link in the app (already shown in the search results footer).
# PEXELS_API_KEY="..."
# Openverse: raises its anonymous rate limit. Register once:
#   curl -X POST https://api.openverse.org/v1/auth_tokens/register/ -H 'Content-Type: application/json' \
#     -d '{"name":"guess-who-game","description":"party game image search","email":"you@example.com"}'
# then verify the e-mail they send you.
# OPENVERSE_CLIENT_ID="..."
# OPENVERSE_CLIENT_SECRET="..."
